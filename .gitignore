# ============================================================
# Dependencies
# ============================================================
node_modules/
.pnpm-store/

# ============================================================
# Build Outputs
# ============================================================
dist/
build/
out/
.next/
.vite/
*.tsbuildinfo
tsconfig.tsbuildinfo
*.js.map
vite.config.js
vite.config.d.ts

# Storage-S3 build emits alongside sources (no outDir)
packages/storage-s3/src/*.js
packages/storage-s3/src/*.d.ts
packages/storage-s3/src/__tests__/*.js
packages/storage-s3/src/__tests__/*.d.ts

# ============================================================
# Framework & Tool Caches
# ============================================================
.nx/
.turbo/
.cache/
.eslintcache

# ============================================================
# Test & Coverage Artifacts
# ============================================================
coverage/
test-results/
playwright-report/
tests/e2e/screenshots/
tests/e2e/visual/
tests/e2e/baselines/

# ============================================================
# Environment & Secrets (Never Commit)
# ============================================================
.env
.env.*
!.env.example
!.env.prod.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
credentials.*
secrets.*
secret.*
service-account*.json
*-credentials.json

# ============================================================
# Logs
# ============================================================
logs/
*.log
/tmp/vibress-*

# ============================================================
# Local Databases & Backups (Never Commit)
# ============================================================
/backups/
*.backup
*.dump
*.sql.gz
*.tar
*.tar.gz
postgres.dump

# ============================================================
# OS & Editor Artifacts
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ============================================================
# Temporary & Local Development State
# ============================================================
tmp/
temp/
/references/
/plans/

# ============================================================
# Content Uploads & Local Themes (Preserve Starter & Morrowe Themes)
# ============================================================
/content/*
!/content/.gitkeep
!/content/theme-starter/
!/content/theme-starter/**
!/content/vibress-theme-starter.zip
!/content/morrowe-magazine/
!/content/morrowe-magazine/**
!/content/MORROWE_VIBRESS_MAGAZINE_v1.1.0.zip
apps/api/content/*
!apps/api/content/.gitkeep
infrastructure/data/
