{
  "name": "vibress-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many --target=dev --all --parallel=5",
    "dev:infra": "docker-compose -f compose.dev.yml up -d",
    "dev:infra:down": "docker-compose -f compose.dev.yml down",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "nx run-many --target=typecheck --all",
    "test": "pnpm -r test",
    "test:unit": "nx run-many --target=test:unit --all",
    "test:integration": "nx run-many --target=test:integration --all",
    "test:e2e": "nx run-many --target=test:e2e --all",
    "test:localization": "vitest run tests/integration/multilingual-production-verification.test.ts tests/integration/locale-expansion-dry-run.test.ts tests/integration/translations-management.test.ts packages/i18n/src/__tests__ packages/theme-core/src/__tests__ && playwright test tests/e2e/multilingual-browser-qa.test.ts tests/e2e/visual/multilingual-visual-regression.test.ts tests/e2e/arabic-rtl-flow.test.ts tests/e2e/translation-management-flow.test.ts",
    "certify:theme": "tsx scripts/certify-theme.ts",
    "report:coverage": "tsx scripts/report-translation-coverage.ts",
    "db:generate": "pnpm --filter @vibress/database run db:generate",
    "db:migrate": "pnpm --filter @vibress/database run db:migrate",
    "db:seed": "pnpm --filter @vibress/database run db:seed",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "owner:create": "tsx scripts/bootstrap-owner.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,html,css}\"",
    "verify:clean-tree": "node scripts/verify-clean-tree.mjs",
    "prod:up": "docker compose -f compose.prod.yml up -d --build",
    "prod:down": "docker compose -f compose.prod.yml down",
    "prod:migrate": "docker compose -f compose.prod.yml run --rm migrate",
    "verify:explicit-any": "node scripts/count-explicit-any.mjs --max 120"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint-plugin": "^23.1.1",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "autocannon": "^8.0.0",
    "eslint": "^10.8.0",
    "jsdom": "^24.1.0",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "typescript": "~5.5.3",
    "tar": ">=7.5.21"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.17.0"
  }
}
