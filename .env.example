NODE_ENV=development
LOG_LEVEL=info
VIBRESS_VERSION=1.0.0

VIBRESS_PORT=7777

WEB_PORT=7778
ADMIN_PORT=7779
API_PORT=7780
PORTAL_PORT=7781
WORKER_HEALTH_PORT=7782

DATABASE_URL=postgresql://vibress:vibress@localhost:5433/vibress
REDIS_URL=redis://localhost:6380

SITE_URL=http://localhost:7777
PORTAL_URL=http://localhost:7777
API_URL=http://127.0.0.1:7780
SITE_NAME=Vibress
SITE_DESCRIPTION=Publishing Platform
SITE_LOCALE=en

# Production CORS/CSRF origins. In development CORS allows local origins.
# In production at least one of CORS_ORIGINS, ADMIN_ORIGIN, or PORTAL_ORIGIN is required.
CORS_ORIGINS=
ADMIN_ORIGIN=
PORTAL_ORIGIN=

SESSION_COOKIE_NAME=vibress_session
MEMBER_SESSION_COOKIE_NAME=vibress_member_session

# Durable event delivery is the default. Set to direct only to use the legacy
# in-process search relay from the API process instead of the worker outbox
# dispatcher.
EVENT_DELIVERY_MODE=outbox
OUTBOX_PUBLISHED_RETENTION_DAYS=7
OUTBOX_FAILED_RETENTION_DAYS=30

VIBRESS_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32-64-hex-chars

# Cryptographic signing key for backup manifests (HMAC-SHA256).
# Must be separate from VIBRESS_ENCRYPTION_KEY.
# Required in production when REQUIRE_BACKUP_SIGNING=1 or for authenticated backups.
# Generate with: openssl rand -hex 32
BACKUP_SIGNING_KEY=
NEWSLETTER_UNSUBSCRIBE_SECRET=dev-unsub-secret

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vibress <no-reply@vibress.local>
EMAIL_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MEMBERS_SIGNUP_ENABLED=true
STORAGE_PROVIDER=local

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vibress
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/vibress

SENTRY_DSN=

# --- OpenTelemetry (optional, fail-open) ---
# TRACING_ENABLED=false disables the exporter entirely (no provider initialized).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer token
# OTEL_SERVICE_NAME=vibress
# OTEL_SAMPLING_RATIO=1
# OTEL_RESOURCE_ATTRIBUTES=env=production,region=eu

# --- First-run setup bootstrap secret ---
# Required in production until the instance is installed (fail-closed boot).
# Generate with:  openssl rand -hex 32
# After installation completes, setup is permanently locked and this value is
# inert — but production still requires it to be present at startup.
# In development, omit it and the API prints a one-time ephemeral token.
VIBRESS_SETUP_TOKEN=

# Optional experimental trusted external plugins (API only).
# In Docker, set this through compose.extensions.example.yml with a read-only
# operator-controlled mount. Absent/empty preserves bundled-only behavior.
# VIBRESS_TRUSTED_PLUGIN_LOCKFILE=/repo/extensions/trusted.json

# Emergency offline recovery ONLY: start a dedicated API maintenance instance
# after draining/stopping ALL normal API replicas and workers. Never enable
# during regular operation; in this mode plugin events and lifecycle are disabled.
# VIBRESS_PLUGIN_RECOVERY_MAINTENANCE=1

# Optional, default OFF: comma-separated pluginId@64-char-SHA256 release fingerprints.
# Each value must match the operator-pinned Admin artifact fingerprint on all API replicas.
# VIBRESS_NATIVE_ADMIN_UI_RELEASES=my-reviewed-plugin@<64-lowercase-hex-sha256>

# NUI-03 experimental write access: separate from Native read-only approval.
# Default OFF. Requires matching operator-approved entrypoint digest and read allowlist.
# VIBRESS_NATIVE_ADMIN_ACTION_RELEASES=my-reviewed-plugin@<64-lowercase-hex-sha256>
