<footer class="theme-footer">
  <div class="theme-container footer-inner">
    <div class="footer-info">
      <p class="footer-copyright">
        &copy; {{ 'now' | format_date: 'year' }} {{ site.title | escape }}. All rights reserved.
      </p>
      {% if site.description %}
        <p class="footer-description">{{ site.description | escape }}</p>
      {% endif %}
    </div>

    {% if site.navigation.secondary.size > 0 %}
      <nav class="footer-nav">
        <ul class="footer-nav-list">
          {% for item in site.navigation.secondary %}
            <li><a href="{{ item.url }}" class="footer-link">{{ item.label | escape }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>
</footer>
