<header class="theme-header">
  <div class="theme-container header-inner">
    <div class="site-branding">
      {% if site.logo %}
        <a href="{% route 'home' %}" class="site-logo-link">
          <img src="{{ site.logo }}" alt="{{ site.title }}" class="site-logo" />
        </a>
      {% else %}
        <a href="{% route 'home' %}" class="site-title-link">
          <span class="site-title">{{ site.title }}</span>
        </a>
      {% endif %}
      {% if site.tagline %}
        <p class="site-tagline">{{ site.tagline }}</p>
      {% endif %}
    </div>

    <div class="header-actions">
      <nav class="site-nav">
        <ul class="nav-list">
          <li><a href="{% route 'home' %}" class="nav-link">{{ "nav.home" | t }}</a></li>
          {% for item in site.navigation.primary %}
            <li><a href="{{ item.url }}" class="nav-link">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {% locale_switcher %}
    </div>
  </div>
</header>
