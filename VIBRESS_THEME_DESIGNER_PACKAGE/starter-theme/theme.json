{
  "id": "vibress-starter-theme",
  "name": "Vibress Starter Theme",
  "version": "1.0.0",
  "description": "Clean, elegant starter theme for Vibress with full Liquid templating support, dark mode, responsive layout, and complete Arabic & RTL localization.",
  "author": {
    "name": "Vibress Team",
    "email": "support@vibress.org",
    "url": "https://vibress.org"
  },
  "homepage": "https://vibress.org",
  "license": "MIT",
  "previewImage": "preview.webp",
  "themeApi": 1,
  "capabilities": ["post", "page", "tag", "author", "archive"],
  "localization": {
    "supportedLocales": ["en", "en-US", "ar", "ar-SA", "*"],
    "supportsLocales": ["*"],
    "rtl": true,
    "dynamicLocale": true,
    "localizedNavigation": true,
    "localizedDates": true,
    "dictionaryDir": "locales"
  },
  "settingsSchemaVersion": 1
}
