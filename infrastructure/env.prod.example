# Production environment template for compose.prod.yml.
# Copy to the repository root as `.env`, fill every value, then:
#   docker compose -f compose.prod.yml up -d --build

# --- Databases ---
# Choose a strong password; Postgres listens ONLY on the internal network.
POSTGRES_USER=vibress
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vibress

# --- Public origins ---
# The externally visible URL (terminating TLS at your LB/CDN).
SITE_URL=https://example.com
ADMIN_ORIGIN=https://example.com
PORTAL_ORIGIN=https://example.com
CORS_ORIGINS=
PORTAL_URL=
API_URL=

# --- Application ---
VIBRESS_VERSION=1.0.0
LOG_LEVEL=info
METRICS_ENABLED=true
TRACING_ENABLED=true
SITE_NAME=Vibress
SITE_DESCRIPTION=Publishing Platform
SITE_LOCALE=en
SESSION_COOKIE_NAME=vibress_session
MEMBER_SESSION_COOKIE_NAME=vibress_member_session
MEMBERS_SIGNUP_ENABLED=true
EVENT_DELIVERY_MODE=outbox

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vibress <no-reply@example.com>
EMAIL_WEBHOOK_SECRET=

# --- Security / billing (required in production) ---
# One-time platform bootstrap token (deploy-production.sh requires min 16 characters).
VIBRESS_SETUP_TOKEN=
VIBRESS_ENCRYPTION_KEY=
NEWSLETTER_UNSUBSCRIBE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storage ---
# local = mounted volume inside the API container (/repo/content/media);
# s3 = the storage-s3 provider (configure bucket/creds per provider).
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/repo/content/media

# --- Gateway ---
VIBRESS_PORT=7777

# --- Request Body Limit ---
# Global default Fastify bodyLimit in bytes for JSON endpoints (defaults to 1048576 / 1MB).
# Raised per-route for large uploads (media: 500MB, themes: 50MB, imports: 50MB).
API_BODY_LIMIT_BYTES=1048576

# --- Reverse Proxy / Rate Limiting IP Trust ---
# Hop count or comma-separated CIDR/IP list trusted by Fastify for X-Forwarded-For resolution.
# Defaults to 1 (safe for the shipped compose topology: gateway -> api).
# When placing Vibress behind an external CDN or Layer 7 Load Balancer (Cloudflare, AWS ALB),
# the ONLY supported approach with the shipped gateway is configuring Nginx realip:
# in infrastructure/nginx/nginx.prod.conf, configure set_real_ip_from, real_ip_header,
# and real_ip_recursive on so Nginx rewrites $remote_addr to the true client IP.
# Fastify remains TRUST_PROXY=1 unchanged.
# (TRUST_PROXY=2 or trusted CIDRs only apply if deploying the API directly without the shipped gateway).
# WARNING: Never set TRUST_PROXY=true in production as it trusts all hops and permits spoofing.
TRUST_PROXY=1