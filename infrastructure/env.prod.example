# Production environment template for compose.prod.yml.
# Copy to the repository root as `.env`, fill every value, then:
#   docker compose -f compose.prod.yml up -d --build

# --- Databases ---
# Choose a strong password; Postgres listens ONLY on the internal network.
POSTGRES_USER=vibress
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vibress

# --- Public origins ---
# The externally visible URL (terminating TLS at your LB/CDN).
SITE_URL=https://example.com
ADMIN_ORIGIN=https://example.com
PORTAL_ORIGIN=https://example.com
CORS_ORIGINS=
PORTAL_URL=
API_URL=

# --- Application ---
VIBRESS_VERSION=0.0.0
LOG_LEVEL=info
METRICS_ENABLED=true
TRACING_ENABLED=true
SITE_NAME=Vibress
SITE_DESCRIPTION=Publishing Platform
SITE_LOCALE=en
SESSION_COOKIE_NAME=vibress_session
MEMBER_SESSION_COOKIE_NAME=vibress_member_session
MEMBERS_SIGNUP_ENABLED=true
EVENT_DELIVERY_MODE=outbox

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vibress <no-reply@example.com>
EMAIL_WEBHOOK_SECRET=

# --- Security / billing (required in production) ---
VIBRESS_ENCRYPTION_KEY=
NEWSLETTER_UNSUBSCRIBE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storage ---
# local = mounted volume inside the API container (/repo/apps/api/.uploads);
# s3 = the storage-s3 provider (configure bucket/creds per provider).
STORAGE_PROVIDER=local

# --- Gateway ---
VIBRESS_PORT=7777