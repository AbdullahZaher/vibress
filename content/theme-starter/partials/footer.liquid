<footer class="theme-footer">
  <div class="theme-container footer-inner">
    <div class="footer-info">
      <p class="footer-copyright">
        &copy; {{ 'now' | format_date: 'year' }} {{ site.title }}. All rights reserved.
      </p>
      {% if site.description %}
        <p class="footer-description">{{ site.description }}</p>
      {% endif %}
    </div>

    {% if site.secondaryNav.size > 0 %}
      <nav class="footer-nav">
        <ul class="footer-nav-list">
          {% for item in site.secondaryNav %}
            <li><a href="{{ item.url }}" class="footer-link">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    {% if site.socialLinks.size > 0 %}
      {% assign isAr = false %}
      {% if site.locale == 'ar' or site.locale == 'ar-SA' or site.direction == 'rtl' %}
        {% assign isAr = true %}
      {% endif %}
      {% assign socialLabel = "Social media links" %}
      {% if isAr %}{% assign socialLabel = "روابط التواصل الاجتماعي" %}{% endif %}
      <nav class="theme-social-links" aria-label="{{ socialLabel }}">
        {% for social in site.socialLinks %}
          <a href="{{ social.url | escape }}" aria-label="{{ social.label | escape }}" title="{{ social.label | escape }}"
             target="_blank" rel="noopener noreferrer" class="theme-social-link">
            <img src="{{ social.iconUrl | escape }}" alt="" width="20" height="20" loading="lazy" />
          </a>
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</footer>
