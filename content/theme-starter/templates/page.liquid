<div class="theme-wrapper font-{{ settings.typographyFamily | default: 'sans' }}">
  {% include 'header' %}

  <main class="theme-main theme-container page-article-layout">
    <article class="article-single page-single">
      <header class="article-header">
        <h1 class="article-title">{{ page.title }}</h1>
        {% if page.excerpt %}
          <p class="article-lead">{{ page.excerpt }}</p>
        {% endif %}
        {% if page.featureImage.url %}
          <figure class="article-featured-image-wrap">
            <img src="{{ page.featureImage.url }}" alt="{{ page.featureImage.alt | default: page.title }}" class="article-featured-image" />
          </figure>
        {% endif %}
      </header>

      <div class="article-content studio-html-content">
        {{ page.html }}
      </div>
    </article>
  </main>

  {% include 'footer' %}
</div>
