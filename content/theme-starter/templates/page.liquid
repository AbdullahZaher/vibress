<!DOCTYPE html>
<html lang="{{ site.locale }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ page.seo.title | default: page.title }} — {{ site.title }}</title>
  <meta name="description" content="{{ page.seo.description | default: page.excerpt }}" />
  <link rel="stylesheet" href="{% asset 'assets/css/theme.css' %}" />
</head>
<body class="theme-body font-{{ settings.typographyFamily | default: 'sans' }}">
  {% include 'header' %}

  <main class="theme-main theme-container page-article-layout">
    <article class="article-single page-single">
      <header class="article-header">
        <h1 class="article-title">{{ page.title }}</h1>
        {% if page.excerpt %}
          <p class="article-lead">{{ page.excerpt }}</p>
        {% endif %}
        {% if page.featureImage.url %}
          <figure class="article-featured-image-wrap">
            <img src="{{ page.featureImage.url }}" alt="{{ page.featureImage.alt | default: page.title }}" class="article-featured-image" />
          </figure>
        {% endif %}
      </header>

      <div class="article-content studio-html-content">
        {{ page.html }}
      </div>
    </article>
  </main>

  {% include 'footer' %}
  <script src="{% asset 'assets/js/theme.js' %}"></script>
</body>
</html>
