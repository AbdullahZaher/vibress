<div class="morrowe mode-{{ settings.colorMode | default: 'auto' }} display-{{ settings.displayStyle | default: 'serif' }}" dir="{{ site.direction | default: 'ltr' | escape }}" lang="{{ site.locale | default: 'en' | escape }}" style="--mr-accent: {{ settings.accentColor | default: '#D8F75A' }};">
  {% include 'header' %}

  <main class="mr-main">
    <header class="mr-archive-hero">
      <div class="mr-container mr-archive-grid">
        <div>
          <span class="mr-eyebrow">{{ 'archive.section' | t }}</span>
          <h1>{{ tag.name | escape }}</h1>
          {% if tag.description %}<p>{{ tag.description | escape }}</p>{% endif %}
        </div>
        {% if tag.featureImage %}
          <img class="mr-archive-image" src="{{ tag.featureImage | escape }}" alt="{{ tag.name | escape }}" />
        {% else %}
          <div class="mr-archive-art" aria-hidden="true"><span></span><span></span><span></span></div>
        {% endif %}
      </div>
    </header>

    <section class="mr-container mr-section">
      <div class="mr-section-heading">
        <span class="mr-index">{{ 'archive.stories' | t }}</span>
        <h2>{{ 'archive.latest_in' | t: name: tag.name }}</h2>
        <span class="mr-rule"></span>
      </div>

      <div class="mr-archive-list">
        {% for post in posts %}
          <article class="mr-archive-row">
            <a class="mr-archive-row-media" href="{{ post.url | escape }}">
              {% if post.featureImage and post.featureImage.url %}
                <img src="{{ post.featureImage.url | escape }}" alt="{{ post.featureImage.alt | default: post.title | escape }}" loading="lazy" />
              {% else %}<span class="mr-image-placeholder mr-image-placeholder-{{ forloop.index }}" aria-hidden="true"></span>{% endif %}
            </a>
            <div class="mr-archive-row-copy">
              <h3><a href="{{ post.url | escape }}">{{ post.title | escape }}</a></h3>
              {% if settings.showExcerpts and post.excerpt %}<p>{{ post.excerpt | excerpt: 170 | escape }}</p>{% endif %}
              <div class="mr-byline">
                {% if post.primaryAuthor %}<a href="{{ post.primaryAuthor.url | escape }}">{{ post.primaryAuthor.name | escape }}</a>{% endif %}
                {% if post.publishedAt %}<time datetime="{{ post.publishedAt | escape }}">{{ post.publishedAt | format_date }}</time>{% endif %}
                {% if settings.showReadingTime and post.readingTimeMinutes %}<span>{{ 'meta.min_read' | t: minutes: post.readingTimeMinutes }}</span>{% endif %}
                {% if site.comments_enabled != false and settings.showComments != false and post.comment_count != nil and post.comment_count > 0 %}
                  <span class="mr-byline-comments">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    {{ post.comment_count }}
                  </span>
                {% endif %}
              </div>
            </div>
          </article>
        {% else %}
          <div class="mr-empty"><h2>{{ 'archive.no_stories' | t }}</h2></div>
        {% endfor %}
      </div>

      {% include 'pagination' %}
    </section>
  </main>

  {% include 'footer' %}
</div>
