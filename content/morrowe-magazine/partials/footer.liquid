<footer class="mr-footer">
  <div class="mr-container mr-footer-grid">
    <div class="mr-footer-brand">
      <a class="mr-footer-wordmark" href="{% route 'home' %}">{{ site.title | escape }}</a>
      {% if site.description %}
        <p>{{ site.description | escape }}</p>
      {% endif %}
      {% if site.socialLinks.size > 0 %}
        {% assign isAr = false %}
        {% if site.locale == 'ar' or site.locale == 'ar-SA' or site.direction == 'rtl' %}
          {% assign isAr = true %}
        {% endif %}
        {% assign socialLabel = "Social media links" %}
        {% if isAr %}{% assign socialLabel = "روابط التواصل الاجتماعي" %}{% endif %}
        <nav class="mr-footer-social-links" aria-label="{{ socialLabel }}">
          {% for social in site.socialLinks %}
            <a href="{{ social.url | escape }}" aria-label="{{ social.label | escape }}" title="{{ social.label | escape }}"
               target="_blank" rel="noopener noreferrer" class="mr-footer-social-link">
              <img src="{{ social.iconUrl | escape }}" alt="" width="20" height="20" loading="lazy" />
            </a>
          {% endfor %}
        </nav>
      {% endif %}
    </div>

    {% if site.navigation.secondary.size > 0 %}
      <nav class="mr-footer-nav" aria-label="{{ 'nav.secondary' | t }}">
        <span class="mr-footer-label">{{ 'nav.navigate' | t }}</span>
        {% for item in site.navigation.secondary %}
          <a href="{{ item.url | escape }}">{{ item.label | escape }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="mr-footer-note">
      <span class="mr-footer-label">{{ 'meta.edition' | t }}</span>
      <p>{{ 'meta.edition_desc' | t }}</p>
    </div>
  </div>
  <div class="mr-container mr-footer-bottom">
    <span>&copy; {{ 'now' | format_date: 'year' }} {{ site.title | escape }}</span>
    <span class="mr-footer-dot">●</span>
    <span>{{ 'meta.theme_credit' | t }}</span>
  </div>
</footer>
